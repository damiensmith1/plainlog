{
  "name": "logger-kit",
  "version": "1.0.0",
  "description": "A lightweight, pluggable, and testable logger for modern Node.js apps.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transports/*": "./dist/transports/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsc --watch",
    "test": "vitest"
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "transport",
    "pluggable",
    "contextual"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/logger-kit"
  },
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.2.0",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "colorette": "^2.0.20"
  }
}
