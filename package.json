{
  "name": "plainlog",
  "version": "1.0.2",
  "description": "A lightweight, pluggable, and testable logger for modern apps (Node + browser).",
  "license": "MIT",
  "author": "Damien Smith",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/damiensmith1/plainlog"
  },
  "keywords": [
    "logger",
    "logging",
    "typescript",
    "transport",
    "pluggable",
    "context"
  ],
  "engines": {
    "node": ">=18"
  },

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },

    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "import": "./dist/formatter.js",
      "require": "./dist/formatter.cjs"
    },

    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "import": "./dist/transports/index.js",
      "require": "./dist/transports/index.cjs"
    },

    "./transports/*": {
      "types": "./dist/transports/*.d.ts",
      "import": "./dist/transports/*.js",
      "require": "./dist/transports/*.cjs"
    },

    "./transports/node": {
      "types": "./dist/transports/node/index.d.ts",
      "import": "./dist/transports/node/index.js",
      "require": "./dist/transports/node/index.cjs"
    },

    "./transports/node/*": {
      "types": "./dist/transports/node/*.d.ts",
      "import": "./dist/transports/node/*.js",
      "require": "./dist/transports/node/*.cjs"
    },

    "./package.json": "./package.json"
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "build": "tsup",
    "test": "vitest"
  },

  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.2.0",
    "vitest": "^0.34.6"
  },

  "dependencies": {
    "colorette": "^2.0.20"
  }
}
